rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTH / IDENTITY
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function sellerPath(sellerId) {
      return /databases/$(database)/documents/sellers/$(sellerId);
    }

    function eventPath(sellerId, eventId) {
      return /databases/$(database)/documents/sellers/$(sellerId)/events/$(eventId);
    }

    function currentUserExists() {
      return isSignedIn()
        && exists(userPath(request.auth.uid));
    }

    function currentUserData() {
      return get(userPath(request.auth.uid)).data;
    }

    function currentSellerId() {
      return currentUserExists()
        && currentUserData().sellerId is string
        ? currentUserData().sellerId
        : "";
    }

    function isAdmin() {
      return currentUserExists()
        && currentUserData().role == "admin"
        && currentUserData().accountStatus == "active";
    }

    function accessIsCurrentlyActive(access) {
      return access.status == "active"
        && (
          access.mode == "lifetime"
          || (
            access.mode == "subscription"
            && access.currentPeriodEnd is timestamp
            && access.currentPeriodEnd > request.time
          )
        );
    }

    function sellerDocumentIsActive(sellerId) {
      return exists(sellerPath(sellerId))
        && get(sellerPath(sellerId)).data.accountStatus == "active";
    }

    function isSellerPrincipal(sellerId) {
      return currentUserExists()
        && currentUserData().role == "seller"
        && currentUserData().accountStatus == "active"
        && exists(sellerPath(sellerId))
        && (
          currentSellerId() == sellerId
          || get(sellerPath(sellerId)).data.ownerUid
            == request.auth.uid
        );
    }

    function isSellerOwner(sellerId) {
      return isSellerPrincipal(sellerId)
        && sellerDocumentIsActive(sellerId);
    }

    function sellerCanOperate(sellerId) {
      return isSellerOwner(sellerId)
        && get(sellerPath(sellerId)).data.onboarding is map
        && get(sellerPath(sellerId)).data.onboarding.complete == true
        && get(sellerPath(sellerId)).data.access is map
        && accessIsCurrentlyActive(
          get(sellerPath(sellerId)).data.access
        );
    }

    function sellerIsPubliclyAvailable(sellerId) {
      return sellerDocumentIsActive(sellerId)
        && get(sellerPath(sellerId)).data.onboarding is map
        && get(sellerPath(sellerId)).data.onboarding.complete == true
        && get(sellerPath(sellerId)).data.access is map
        && accessIsCurrentlyActive(
          get(sellerPath(sellerId)).data.access
        );
    }

    function eventIsPubliclyAvailable(sellerId, eventId) {
      return sellerIsPubliclyAvailable(sellerId)
        && exists(eventPath(sellerId, eventId))
        && get(eventPath(sellerId, eventId)).data.status == "active"
        && (
          !get(eventPath(sellerId, eventId)).data.keys().hasAny(["isActive"])
          || get(eventPath(sellerId, eventId)).data.isActive != false
        );
    }

    // =========================================================
    // SHARED VALIDATORS
    // =========================================================

    function validLanguage(value) {
      return value in ["pt", "en", "ja"];
    }

    function validCountry(value) {
      return value in ["JP", "BR", "US"];
    }

    function validCurrency(value) {
      return value in ["JPY", "BRL", "USD"];
    }

    function validLocale(value) {
      return value in ["ja-JP", "pt-BR", "en-US"];
    }

    function validCountryCurrency(country, currency) {
      return (
        country == "JP" && currency == "JPY"
      ) || (
        country == "BR" && currency == "BRL"
      ) || (
        country == "US" && currency == "USD"
      );
    }

    function validCountryLocale(country, locale) {
      return (
        country == "JP" && locale == "ja-JP"
      ) || (
        country == "BR" && locale == "pt-BR"
      ) || (
        country == "US" && locale == "en-US"
      );
    }

    function validCountryTimeZone(country, timeZone) {
      return (
        country == "JP"
        && timeZone == "Asia/Tokyo"
      ) || (
        country == "BR"
        && timeZone in [
          "America/Sao_Paulo",
          "America/Manaus",
          "America/Cuiaba",
          "America/Rio_Branco",
          "America/Noronha"
        ]
      ) || (
        country == "US"
        && timeZone in [
          "America/New_York",
          "America/Chicago",
          "America/Denver",
          "America/Los_Angeles",
          "America/Anchorage",
          "Pacific/Honolulu"
        ]
      );
    }

    function validPlan(value) {
      return value in [
        "starter",
        "pro",
        "business"
      ];
    }

    function validBillingInterval(value) {
      return value in [
        "monthly",
        "annual"
      ];
    }

    function expectedMonthlyAmount(plan, country) {
      return plan == "starter"
        ? (
          country == "JP" ? 2980
          : country == "BR" ? 6900
          : country == "US" ? 1900
          : -1
        )
        : plan == "pro"
          ? (
            country == "JP" ? 5980
            : country == "BR" ? 13900
            : country == "US" ? 3900
            : -1
          )
          : plan == "business"
            ? (
              country == "JP" ? 9980
              : country == "BR" ? 22900
              : country == "US" ? 6900
              : -1
            )
            : -1;
    }

    function expectedPlanAmount(
      plan,
      country,
      billingInterval
    ) {
      let monthly =
        expectedMonthlyAmount(
          plan,
          country
        );

      return billingInterval == "annual"
        ? monthly * 10
        : monthly;
    }

    function planRank(plan) {
      return plan == "starter"
        ? 1
        : plan == "pro"
          ? 2
          : plan == "business"
            ? 3
            : -1;
    }

    function expectedRequestType(
      currentPlan,
      currentStatus,
      requestedPlan
    ) {
      return currentStatus != "active"
        ? "new"
        : currentPlan == requestedPlan
          ? "renew"
          : planRank(requestedPlan)
              > planRank(currentPlan)
            ? "upgrade"
            : "downgrade";
    }

    function expectedMaxEvents(plan) {
      return plan == "starter"
        ? 1
        : plan == "pro"
          ? 3
          : plan == "business"
            ? 10
            : -1;
    }

    function expectedMaxProducts(plan) {
      return plan == "starter"
        ? 20
        : plan == "pro"
          ? 60
          : plan == "business"
            ? 200
            : -1;
    }

    function validLimitsSnapshot(plan, limits) {
      return limits is map
        && limits.keys().hasOnly([
          "maxEvents",
          "maxProducts"
        ])
        && limits.maxEvents is int
        && limits.maxProducts is int
        && limits.maxEvents
          == expectedMaxEvents(plan)
        && limits.maxProducts
          == expectedMaxProducts(plan);
    }

    // =========================================================
    // USERS — IDENTITY AND ACCESS ROLE ONLY
    // =========================================================

    function validOwnUserCreate(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "schemaVersion",
          "role",
          "sellerId",
          "email",
          "displayName",
          "photoURL",
          "uiLanguage",
          "accountStatus",
          "createdAt",
          "updatedAt",
          "createdBy",
          "updatedBy"
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.role == "seller"
        && request.resource.data.sellerId == userId
        && validLanguage(
          request.resource.data.uiLanguage
        )
        && request.resource.data.accountStatus == "active"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == userId
        && request.resource.data.updatedBy == userId;
    }

    function validOwnUserUpdate(userId) {
      let changed =
        request.resource.data
          .diff(resource.data)
          .affectedKeys();

      return isSignedIn()
        && request.auth.uid == userId
        && changed.hasOnly([
          "displayName",
          "photoURL",
          "uiLanguage",
          "updatedAt",
          "updatedBy"
        ])
        && (
          !changed.hasAny(["uiLanguage"])
          || validLanguage(
            request.resource.data.uiLanguage
          )
        )
        && (
          !changed.hasAny(["updatedAt"])
          || request.resource.data.updatedAt
            == request.time
        )
        && (
          !changed.hasAny(["updatedBy"])
          || request.resource.data.updatedBy
            == request.auth.uid
        );
    }

    match /users/{userId} {
      allow read:
        if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
        );

      allow create:
        if validOwnUserCreate(userId)
        || isAdmin();

      allow update:
        if validOwnUserUpdate(userId)
        || isAdmin();

      allow delete:
        if isAdmin();
    }

    // =========================================================
    // ADMIN COLLECTION-GROUP QUERIES
    // =========================================================

    /*
     * The admin plans screen uses:
     *
     *   collectionGroup(db, "planRequests")
     *
     * Collection-group queries must be authorized by a recursive wildcard
     * rule that covers every collection with that ID. The seller-scoped rule
     * below remains responsible for owner reads and all writes.
     */
    match /{path=**}/planRequests/{requestId} {
      allow read: if isAdmin();
    }

    // =========================================================
    // SELLERS — COMMERCIAL PROFILE AND ACCESS
    // =========================================================

    function validRegional(regional, complete) {
      return regional is map
        && regional.keys().hasOnly([
          "operatingCountry",
          "currency",
          "locale",
          "timeZone"
        ])
        && (
          complete == false
          ? (
            regional.operatingCountry == null
            && regional.currency == null
            && regional.locale == null
            && regional.timeZone == null
          )
          : (
            validCountry(
              regional.operatingCountry
            )
            && validCurrency(
              regional.currency
            )
            && validLocale(
              regional.locale
            )
            && regional.timeZone is string
            && validCountryCurrency(
              regional.operatingCountry,
              regional.currency
            )
            && validCountryLocale(
              regional.operatingCountry,
              regional.locale
            )
            && validCountryTimeZone(
              regional.operatingCountry,
              regional.timeZone
            )
          )
        );
    }

    function validOnboarding(onboarding) {
      return onboarding is map
        && onboarding.keys().hasOnly([
          "complete",
          "completedAt",
          "schemaVersion"
        ])
        && onboarding.complete is bool
        && onboarding.schemaVersion == 2
        && (
          onboarding.complete == false
          ? onboarding.completedAt == null
          : onboarding.completedAt is timestamp
        );
    }

    function validDefaultAccess(access) {
      return access is map
        && access.keys().hasOnly([
          "planId",
          "mode",
          "billingInterval",
          "status",
          "source",
          "currentPeriodStart",
          "currentPeriodEnd",
          "grantedAt",
          "grantedBy",
          "note"
        ])
        && access.planId == "starter"
        && access.mode == "subscription"
        && access.billingInterval == "monthly"
        && access.status == "none"
        && access.source == "purchase"
        && access.currentPeriodStart == null
        && access.currentPeriodEnd == null
        && access.grantedAt == null
        && access.grantedBy == null
        && access.note == null;
    }


    function validBrandColor(value) {
      return value is string
        && value.matches('^#[0-9a-fA-F]{6}$');
    }

    function validSellerContact(contact) {
      return contact is map
        && contact.keys().hasOnly([
          "phone",
          "email",
          "whatsapp",
          "instagram",
          "website"
        ])
        && (
          !contact.keys().hasAny(["phone"])
          || (
            contact.phone is string
            && contact.phone.size() <= 80
          )
        )
        && (
          !contact.keys().hasAny(["email"])
          || (
            contact.email is string
            && contact.email.size() <= 180
          )
        )
        && (
          !contact.keys().hasAny(["whatsapp"])
          || (
            contact.whatsapp is string
            && contact.whatsapp.size() <= 80
          )
        )
        && (
          !contact.keys().hasAny(["instagram"])
          || (
            contact.instagram is string
            && contact.instagram.size() <= 180
          )
        )
        && (
          !contact.keys().hasAny(["website"])
          || (
            contact.website is string
            && contact.website.size() <= 500
          )
        );
    }

    function validReceiptIdentity(receipt) {
      return receipt is map
        && receipt.keys().hasOnly([
          "headerText",
          "footerText"
        ])
        && (
          !receipt.keys().hasAny(["headerText"])
          || (
            receipt.headerText is string
            && receipt.headerText.size() <= 500
          )
        )
        && (
          !receipt.keys().hasAny(["footerText"])
          || (
            receipt.footerText is string
            && receipt.footerText.size() <= 1000
          )
        );
    }

    function validOptionalSellerIdentity(data) {
      return (
          !data.keys().hasAny(["identitySchemaVersion"])
          || data.identitySchemaVersion == 1
        )
        && (
          !data.keys().hasAny(["storeDescription"])
          || (
            data.storeDescription is string
            && data.storeDescription.size() <= 1200
          )
        )
        && (
          !data.keys().hasAny(["logoUrl"])
          || (
            data.logoUrl is string
            && data.logoUrl.size() <= 1500
          )
        )
        && (
          !data.keys().hasAny(["bannerUrl"])
          || (
            data.bannerUrl is string
            && data.bannerUrl.size() <= 1500
          )
        )
        && (
          !data.keys().hasAny(["brandPrimaryColor"])
          || validBrandColor(data.brandPrimaryColor)
        )
        && (
          !data.keys().hasAny(["brandAccentColor"])
          || validBrandColor(data.brandAccentColor)
        )
        && (
          !data.keys().hasAny(["contact"])
          || validSellerContact(data.contact)
        )
        && (
          !data.keys().hasAny(["receiptIdentity"])
          || validReceiptIdentity(data.receiptIdentity)
        );
    }

    function validOwnSellerCreate(sellerId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          "schemaVersion",
          "ownerUid",
          "storeName",
          "identitySchemaVersion",
          "storeDescription",
          "logoUrl",
          "bannerUrl",
          "brandPrimaryColor",
          "brandAccentColor",
          "contact",
          "receiptIdentity",
          "storefrontLanguage",
          "regional",
          "onboarding",
          "accountStatus",
          "access",
          "limitsOverride",
          "regionId",
          "regionName",
          "whatsapp",
          "messengerId",
          "pickupLink",
          "pickupNote",
          "createdAt",
          "updatedAt",
          "createdBy",
          "updatedBy"
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.ownerUid == request.auth.uid
        && (
          sellerId == request.auth.uid
          || sellerId == currentSellerId()
        )
        && request.resource.data.storeName == null
        && validLanguage(
          request.resource.data.storefrontLanguage
        )
        && validRegional(
          request.resource.data.regional,
          false
        )
        && validOnboarding(
          request.resource.data.onboarding
        )
        && request.resource.data.onboarding.complete == false
        && request.resource.data.accountStatus == "active"
        && validDefaultAccess(
          request.resource.data.access
        )
        && request.resource.data.limitsOverride == null
        && validOptionalSellerIdentity(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validOwnSellerUpdate(sellerId) {
      let changed =
        request.resource.data
          .diff(resource.data)
          .affectedKeys();

      let complete =
        request.resource.data.onboarding.complete;

      return isSellerOwner(sellerId)
        && changed.hasOnly([
          "storeName",
          "identitySchemaVersion",
          "storeDescription",
          "logoUrl",
          "bannerUrl",
          "brandPrimaryColor",
          "brandAccentColor",
          "contact",
          "receiptIdentity",
          "storefrontLanguage",
          "regional",
          "onboarding",
          "regionId",
          "regionName",
          "whatsapp",
          "messengerId",
          "pickupLink",
          "pickupNote",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.ownerUid
          == resource.data.ownerUid
        && request.resource.data.storeName is string
        && request.resource.data.storeName.size() > 0
        && request.resource.data.storeName.size() <= 120
        && validLanguage(
          request.resource.data.storefrontLanguage
        )
        && validOnboarding(
          request.resource.data.onboarding
        )
        && complete == true
        && validRegional(
          request.resource.data.regional,
          true
        )
        && (
          !changed.hasAny(["onboarding"])
          || request.resource.data.onboarding.completedAt
            == request.time
          || request.resource.data.onboarding
            == resource.data.onboarding
        )
        && validOptionalSellerIdentity(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /sellers/{sellerId} {
      function validSellerOrderMetadataUpdate() {
        let changed = request.resource.data
          .diff(resource.data)
          .affectedKeys();

        return changed.hasOnly([
          "sellerUnread",
          "sellerReadAt",
          "lastMessageText",
          "lastMessageAt",
          "updatedAt",
          "updatedBy"
        ]);
      }

      // O documento raiz contém ownership, assinatura e limites privados.
      // A vitrine pública recebe apenas um DTO sanitizado via /api/public/sellers.
      allow read:
        if isAdmin()
        || isSellerPrincipal(sellerId);

      allow create:
        if isAdmin()
        || validOwnSellerCreate(sellerId);

      allow update:
        if isAdmin()
        || validOwnSellerUpdate(sellerId);

      allow delete:
        if isAdmin();

      // =======================================================
      // PLAN REQUESTS
      // =======================================================

      function validPlanRequestCreate() {
        return isSellerOwner(sellerId)
          && request.resource.data.keys().hasOnly([
            "schemaVersion",
            "sellerId",
            "ownerUid",
            "planId",
            "billingInterval",
            "requestType",
            "status",
            "country",
            "currency",
            "amountMinor",
            "limitsSnapshot",
            "createdAt",
            "createdBy",
            "updatedAt",
            "updatedBy",
            "reviewedAt",
            "reviewedBy",
            "reviewNote"
          ])
          && request.resource.data.schemaVersion == 2
          && request.resource.data.sellerId == sellerId
          && get(sellerPath(sellerId)).data.ownerUid
            == request.auth.uid
          && request.resource.data.ownerUid
            == get(sellerPath(sellerId)).data.ownerUid
          && request.resource.data.country
            == get(sellerPath(sellerId)).data.regional.operatingCountry
          && request.resource.data.currency
            == get(sellerPath(sellerId)).data.regional.currency
          && validPlan(
            request.resource.data.planId
          )
          && validBillingInterval(
            request.resource.data.billingInterval
          )
          && request.resource.data.requestType in [
            "new",
            "renew",
            "upgrade",
            "downgrade"
          ]
          && !(
            get(sellerPath(sellerId)).data.access.mode == "lifetime"
            && accessIsCurrentlyActive(
              get(sellerPath(sellerId)).data.access
            )
          )
          && request.resource.data.requestType
            == expectedRequestType(
              get(sellerPath(sellerId)).data.access.planId,
              accessIsCurrentlyActive(
                get(sellerPath(sellerId)).data.access
              )
                ? "active"
                : "past_due",
              request.resource.data.planId
            )
          && request.resource.data.status == "pending"
          && validCountry(
            request.resource.data.country
          )
          && validCurrency(
            request.resource.data.currency
          )
          && validCountryCurrency(
            request.resource.data.country,
            request.resource.data.currency
          )
          && request.resource.data.amountMinor is int
          && request.resource.data.amountMinor
            == expectedPlanAmount(
              request.resource.data.planId,
              request.resource.data.country,
              request.resource.data.billingInterval
            )
          && validLimitsSnapshot(
            request.resource.data.planId,
            request.resource.data.limitsSnapshot
          )
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.reviewedAt == null
          && request.resource.data.reviewedBy == null
          && request.resource.data.reviewNote == null;
      }

      match /planRequests/{requestId} {
        allow read:
          if isAdmin()
          || isSellerOwner(sellerId);

        allow create:
          if validPlanRequestCreate();

        allow update, delete:
          if isAdmin();
      }

      // =======================================================
      // SELLER-OWNED CATALOG
      // =======================================================

      match /categories/{categoryId} {
        // Categorias são administrativas; a loja deriva as vitrines dos
        // produtos públicos e não precisa listar esta coleção.
        allow read:
          if isAdmin()
          || isSellerOwner(sellerId);

        allow create, update, delete:
          if isAdmin()
          || sellerCanOperate(sellerId);
      }

      match /products/{productId} {
        allow read:
          if isAdmin()
          || isSellerOwner(sellerId)
          || (
            sellerIsPubliclyAvailable(sellerId)
            && resource.data.status in [
              "active",
              "made_to_order"
            ]
          );

        allow create, update, delete:
          if isAdmin()
          || sellerCanOperate(sellerId);
      }

      match /offers/{offerId} {
        allow read:
          if isAdmin()
          || isSellerOwner(sellerId)
          || (
            sellerIsPubliclyAvailable(sellerId)
            && resource.data.status == "active"
          );

        allow create, update, delete:
          if isAdmin()
          || sellerCanOperate(sellerId);
      }

      match /settings/{settingId} {
        allow read:
          if isAdmin()
          || isSellerOwner(sellerId)
          || (
            settingId == "shipping"
            && sellerIsPubliclyAvailable(sellerId)
          );

        allow create, update, delete:
          if isAdmin()
          || isSellerOwner(sellerId);
      }

      /*
       * Marcadores privados de idempotência criados pelo backend.
       * Nem clientes públicos nem sellers precisam acessar esta coleção.
       */
      match /orderRequests/{requestId} {
        allow read, write: if false;
      }

      // Histórico imutável criado exclusivamente pelo backend de pedidos.
      match /inventoryMovements/{movementId} {
        allow read:
          if isAdmin()
          || isSellerOwner(sellerId);

        allow create, update, delete: if false;
      }

      // =======================================================
      // STORE ORDERS
      // =======================================================

      match /storeOrders/{orderId} {
        /*
         * Pedidos públicos são criados exclusivamente pelo backend
         * /api/orders/create usando Firebase Admin.
         * O SDK do cliente não pode definir preços, descontos ou totais.
         */
        allow create: if false;

        allow read:
          if isAdmin()
          || isSellerOwner(sellerId);

        allow update:
          if isAdmin()
          || (
            sellerCanOperate(sellerId)
            && validSellerOrderMetadataUpdate()
          );

        allow delete:
          if isAdmin();
      }

      // =======================================================
      // EVENTS
      // =======================================================

      match /events/{eventId} {
        allow read:
          if isAdmin()
          || isSellerOwner(sellerId)
          || eventIsPubliclyAvailable(sellerId, eventId);

        allow create, update, delete:
          if isAdmin()
          || sellerCanOperate(sellerId);

        match /products/{productId} {
          allow read:
            if isAdmin()
            || isSellerOwner(sellerId)
            || eventIsPubliclyAvailable(sellerId, eventId);
          allow create, update, delete:
            if isAdmin()
            || sellerCanOperate(sellerId);
        }

        match /items/{itemId} {
          allow read:
            if isAdmin()
            || isSellerOwner(sellerId)
            || eventIsPubliclyAvailable(sellerId, eventId);
          allow create, update, delete:
            if isAdmin()
            || sellerCanOperate(sellerId);
        }

        match /offers/{offerId} {
          allow read:
            if isAdmin()
            || isSellerOwner(sellerId)
            || eventIsPubliclyAvailable(sellerId, eventId);
          allow create, update, delete:
            if isAdmin()
            || sellerCanOperate(sellerId);
        }

        match /orders/{orderId} {
          // O backend unificado é o único criador de pedidos.
          allow create: if false;

          allow read:
            if isAdmin()
            || isSellerOwner(sellerId);

          allow update:
            if isAdmin()
            || (
              sellerCanOperate(sellerId)
              && validSellerOrderMetadataUpdate()
            );

          allow delete:
            if isAdmin();

          match /messages/{messageId} {
            // Clientes usam /api/public/event-chat com token secreto do pedido.
            // O SDK do navegador nunca recebe acesso público à subcoleção.
            allow read:
              if isAdmin()
              || isSellerOwner(sellerId);

            allow create:
              if isAdmin()
              || (
                sellerCanOperate(sellerId)
                && request.resource.data.keys().hasOnly([
                  "schemaVersion",
                  "text",
                  "senderId",
                  "senderRole",
                  "createdAt",
                  "createdBy"
                ])
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.text.size() <= 1500
                && request.resource.data.senderRole == "seller"
                && request.resource.data.senderId in [
                  request.auth.uid,
                  sellerId
                ]
                && request.resource.data.createdAt == request.time
              );

            allow update:
              if isAdmin()
              || (
                isSellerOwner(sellerId)
                && request.resource.data
                  .diff(resource.data)
                  .affectedKeys()
                  .hasOnly(["sellerReadAt"])
                && request.resource.data.sellerReadAt == request.time
              );

            allow delete:
              if isAdmin();
          }
        }
      }
    }

    // =========================================================
    // CUSTOMERS / REWARDS — BACKEND ONLY
    // =========================================================

    /*
     * Perfis, índices de pedidos, carteiras e transações de pontos são
     * acessados exclusivamente pelas APIs autenticadas com Firebase Admin.
     */
    match /customers/{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // LEGACY ROOT COLLECTIONS — PERMANENTLY BLOCKED
    // =========================================================

    match /events/{document=**} {
      allow read, write: if false;
    }

    match /products/{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
